MAKMA_PROVIDER=local
MAKMA_PLANNER_MODE=deterministic
MAKMA_DATABASE_PATH=./data/makma.db
# Configure only when using a trusted local or remote provider.
# MAKMA_BASE_URL=http://localhost:11434
# MAKMA_MODEL=qwen2.5:7b
# MAKMA_API_KEY=
# Planning modes: deterministic, hybrid, model. Hybrid/model require an LLM provider.\n# MAKMA_PLANNER_MODE=hybrid\n# Set a bearer token before exposing the backend beyond localhost.\n# MAKMA_API_TOKEN=replace-with-a-long-random-secret\n
# Browser console origins allowed by CORS. Comma-separated.
# MAKMA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://maharshimak.github.io

# Optional semantic memory through an OpenAI-compatible embeddings endpoint.
# MAKMA_MEMORY_EMBEDDING_BASE_URL=http://localhost:8001/v1
# MAKMA_MEMORY_EMBEDDING_MODEL=nomic-embed-text
# MAKMA_MEMORY_EMBEDDING_API_KEY=

# Optional read-only MAK'MA satellite tools. These tools register only when configured.
# MAKMA_RAG_BASE_URL=http://127.0.0.1:8101
# MAKMA_RAG_API_TOKEN=
# MAKMA_DATA_COPILOT_BASE_URL=http://127.0.0.1:8102
# MAKMA_DATA_COPILOT_API_TOKEN=
